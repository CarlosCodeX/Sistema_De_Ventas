@model List<CapaEntidad.Usuario>

<link href="~/Content/IndexUsuario.css" rel="stylesheet" />

<div class="header-navegador">
    <div class="logo">
        <h1>Sistema de Ventas</h1>
        <img src="../assets/img/shopping-basket.png" alt="Logo">
    </div>
    <nav class="navegador">
        <p>Nuevo en la app?</p>
        <a href="">Guia</a>
        <a href="">Soporte</a>
    </nav>
</div>
<div class="grid-login">
    <div class="logo-login">
        <img src="../assets/img/login.png" alt="Logo">
    </div>
    <form action="@Url.Action("Login", "Usuario")" method="post">
        <h1>Inicio de Sesión</h1>
        <div>
            <div class="inputs">
                <p>Nombre de Usuario</p>
                <input type="text" name="nombre" placeholder="Correo">
                <label for="usuario"></label>

                <p>Contraseña</p>
                <input type="password" name="clave" placeholder="Contraseña">
                <label for="contraseña"></label>
            </div>
        </div>
        <button class="boton">Iniciar Sesión</button>
        <div class="soporte">
            <p>Olvidaste tu contraseña?</p>
            <a href="">Soporte</a>
        </div>
    </form>
</div>

