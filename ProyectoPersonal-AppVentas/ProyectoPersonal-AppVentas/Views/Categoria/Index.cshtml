@model List<CapaEntidad.Categoria>
<link href="~/Content/IndexCategoria.css" rel="stylesheet" />

<!-- HEADER SUPERIOR -->
<header class="header-top">
    <div class="header-brand">
        <div class="brand-content">
            <div class="logo-header">
                <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="25" cy="25" r="22" fill="#33FF51" />
                    <path d="M 17 22 L 25 17 L 33 22 L 33 33 L 17 33 Z" fill="white" />
                </svg>
            </div>
            <h1>Sistema De Ventas</h1>
        </div>
    </div>
    <nav class="header-nav">
        <a href="@Url.Action("InicioAdministrador", "Usuario")">Inicio</a>
        <a href="@Url.Action("Index", "Categoria")" class="active">Mis Categorías</a>
        <a href="@Url.Action("Index", "Producto")">Mis Productos</a>
        <a href="@Url.Action("Index", "Venta")">Mis Ventas</a>
        <a href="@Url.Action("Index", "Cliente")">Mis Clientes</a>
        <a href="@Url.Action("Registrar", "Usuario")">Mis Trabajadores</a>
        <a href="@Url.Action("CerrarSesion", "Usuario")" class="logout-link">Cerrar Sesión</a>
    </nav>
</header>

<main class="contenido-full">
    <div class="header-contenido">
        <div>
            <h1>Categorías</h1>
            <p class="subtitle">Gestiona las categorías de productos</p>
        </div>
        <button class="btn-agregar" onclick="abrirModal()">
            <span class="btn-icon">+</span>
            <span>Nueva Categoría</span>
        </button>
    </div>

    <!-- VISTA DE CARDS -->
    <section class="categorias-grid">
        @foreach (var c in Model)
        {
            <div class="categoria-card">
                <div class="card-header">
                    <div class="categoria-icon">
                        📁
                    </div>
                    <div class="card-header-info">
                        <h3 class="categoria-nombre">@c.Nombre</h3>
                        <span class="categoria-id">#@c.IdCategoria</span>
                    </div>
                    @if (c.Activo)
                    {
                        <span class="badge badge-activo">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-inactivo">Inactivo</span>
                    }
                </div>

                <div class="card-body">
                    <div class="descripcion-box">
                        <span class="descripcion-label">Descripción</span>
                        <p class="descripcion-text">@c.Descripcion</p>
                    </div>
                </div>

                <div class="card-footer">
                    <button class="btn-card btn-editar" onclick="editar(@c.IdCategoria,'@c.Nombre','@c.Descripcion')" title="Editar">
                        <span>✏️</span>
                        Editar
                    </button>
                    <button class="btn-card btn-estado" onclick="cambiarEstado(@c.IdCategoria, @(c.Activo.ToString().ToLower()))" title="Cambiar Estado">
                        <span>🔄</span>
                        Estado
                    </button>
                </div>
            </div>
        }
    </section>

    <!-- MODAL -->
    <div id="modalCategoria" class="modal">
        <div class="modal-overlay" onclick="cerrarModal()"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h3>Nueva Categoría</h3>
                <button class="btn-close" onclick="cerrarModal()">✕</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="idCategoria" value="0" />

                <div class="form-group">
                    <label for="nombre">Nombre de la Categoría</label>
                    <input type="text" id="nombre" placeholder="Ej: Bebidas, Snacks, etc." />
                </div>

                <div class="form-group">
                    <label for="descripcion">Descripción</label>
                    <textarea id="descripcion" rows="5" placeholder="Descripción detallada de la categoría..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" onclick="cerrarModal()">Cancelar</button>
                <button class="btn-primary" onclick="guardar()">Guardar Categoría</button>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="@Url.Content("~/Scripts/categoria.js")"></script>
}