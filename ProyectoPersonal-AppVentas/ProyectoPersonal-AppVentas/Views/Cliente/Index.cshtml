@model List<CapaEntidad.Cliente>
<link href="~/Content/IndexCliente.css" rel="stylesheet" />

<!-- HEADER SUPERIOR -->
<header class="header-top">
    <div class="header-brand">
        <div class="brand-content">
            <div class="logo-header">
                <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="25" cy="25" r="22" fill="#33FF51" />
                    <path d="M 17 22 L 25 17 L 33 22 L 33 33 L 17 33 Z" fill="white" />
                </svg>
            </div>
            <h1>Sistema A&M</h1>
        </div>
    </div>
    <nav class="header-nav">
        <a href="@Url.Action("InicioAdministrador", "Usuario")">Inicio</a>
        <a href="@Url.Action("Index", "Categoria")">Mis Categorías</a>
        <a href="@Url.Action("Index", "Producto")">Mis Productos</a>
        <a href="@Url.Action("Index", "Venta")">Mis Ventas</a>
        <a href="@Url.Action("Index", "Cliente")" class="active">Mis Clientes</a>
        <a href="@Url.Action("Registrar", "Usuario")">Mis Trabajadores</a>
        <a href="@Url.Action("CerrarSesion", "Usuario")" class="logout-link">Cerrar Sesión</a>
    </nav>
</header>

<main class="contenido-full">
    <div class="header-contenido">
        <div>
            <h1>Clientes</h1>
            <p class="subtitle">Administra la información de tus clientes</p>
        </div>
        <button class="btn-agregar" onclick="abrirModal()">
            <span class="btn-icon">+</span>
            <span>Nuevo Cliente</span>
        </button>
    </div>

    <!-- VISTA DE CARDS -->
    <section class="clientes-grid">
        @foreach (var cliente in Model)
        {
            <div class="cliente-card">
                <div class="card-header">
                    <div class="cliente-avatar">
                        @cliente.Nombre.Substring(0, 1).ToUpper()
                    </div>
                    <div class="card-header-info">
                        <h3 class="cliente-nombre">@cliente.Nombre</h3>
                        <span class="cliente-id">#@cliente.IdCliente</span>
                    </div>
                    @if (cliente.Activo)
                    {
                        <span class="badge badge-activo">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-inactivo">Inactivo</span>
                    }
                </div>

                <div class="card-body">
                    <div class="info-item">
                        <span class="info-icon">📄</span>
                        <div class="info-content">
                            <span class="info-label">Documento</span>
                            <span class="info-value">@cliente.Documento</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-icon">📞</span>
                        <div class="info-content">
                            <span class="info-label">Teléfono</span>
                            <span class="info-value">@cliente.Telefono</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-icon">📧</span>
                        <div class="info-content">
                            <span class="info-label">Email</span>
                            <span class="info-value">@cliente.Email</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-icon">📅</span>
                        <div class="info-content">
                            <span class="info-label">Registro</span>
                            <span class="info-value">@cliente.FechaRegistro.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button class="btn-card btn-editar" onclick="editar(@cliente.IdCliente, '@cliente.Nombre', '@cliente.Documento', '@cliente.Telefono', '@cliente.Email')">
                        <span>✏️</span>
                        Editar
                    </button>
                </div>
            </div>
        }
    </section>

    <!-- MODAL -->
    <div id="modalCliente" class="modal">
        <div class="modal-overlay" onclick="cerrarModal()"></div>
        <div class="modal-content">
            <div class="modal-header">
                <h3>Nuevo Cliente</h3>
                <button class="btn-close" onclick="cerrarModal()">✕</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="idCliente" value="0" />

                <div class="form-row">
                    <div class="form-group">
                        <label for="Nombre">Nombre Completo</label>
                        <input type="text" id="Nombre" placeholder="Ej: Juan Pérez" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="documento">Documento</label>
                        <input type="text" id="documento" placeholder="DNI o RUC" />
                    </div>

                    <div class="form-group">
                        <label for="telefono">Teléfono</label>
                        <input type="text" id="telefono" placeholder="+51 999 999 999" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" placeholder="cliente@ejemplo.com" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" onclick="cerrarModal()">Cancelar</button>
                <button class="btn-primary" onclick="guardar()">Guardar Cliente</button>
            </div>
        </div>
    </div>
</main>

@section scripts {
    <script src="@Url.Content("~/Scripts/cliente.js")"></script>
}


